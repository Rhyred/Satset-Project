## 4. Database ERD (Setelah Refactor)

```mermaid
erDiagram
    users ||--o{ laporan_user : "membuat"
    users ||--o{ antrean_birokrasi : "mengajukan"
    users ||--o{ notifikasi : "menerima"
    users ||--o{ tindak_lanjut_laporan : "admin menindak"
    kategori_layanan ||--o{ laporan_user : "dikategorikan"
    kategori_layanan ||--o{ antrean_birokrasi : "dikategorikan"
    laporan_user ||--o{ tindak_lanjut_laporan : "ditindaklanjuti"

    users {
        bigint id PK
        varchar nik UK
        varchar nama_lengkap
        varchar username UK
        varchar email UK
        varchar password
        varchar role "ADMIN/USER"
        varchar no_telepon
        varchar alamat
        timestamp created_at
        timestamp updated_at
    }

    laporan_user {
        bigint id PK
        varchar judul_laporan
        text deskripsi
        varchar lampiran_url
        varchar status_laporan "DITERIMA/DIPROSES/SELESAI/DITOLAK"
        bigint user_id FK
        bigint kategori_id FK
        timestamp created_at
        timestamp updated_at
    }

    antrean_birokrasi {
        bigint id PK
        varchar nomor_antrian UK
        varchar jenis_surat
        varchar status_antrian "MENUNGGU/DIPANGGIL/DILAYANI/SELESAI"
        timestamp waktu_pengajuan
        bigint user_id FK
        bigint kategori_id FK
        timestamp created_at
        timestamp updated_at
    }
```

